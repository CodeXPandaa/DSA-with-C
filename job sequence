#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int index;    // Job number (1-based index)
    int deadline; // Deadline for the job
    int profit;   // Profit from the job
} Job;

// Comparison function to sort jobs in descending order of profit
int compare(const void *a, const void *b) {
    return ((Job *)b)->profit - ((Job *)a)->profit;
}

// Function to schedule jobs using a greedy approach
void jobSequencing(Job jobs[], int n) {
    // Step 1: Sort jobs in descending order of profit
    qsort(jobs, n, sizeof(Job), compare);

    int maxDeadline = 0;
    for (int i = 0; i < n; i++)
        if (jobs[i].deadline > maxDeadline)
            maxDeadline = jobs[i].deadline;

    // Step 2: Create an array to track free slots
    int slot[maxDeadline + 1]; // Slot availability (-1 means free)
    for (int i = 0; i <= maxDeadline; i++)
        slot[i] = -1;

    int totalProfit = 0; // Track total profit

    // Step 3: Assign jobs to slots greedily
    for (int i = 0; i < n; i++) {
        for (int j = jobs[i].deadline; j > 0; j--) {
            if (slot[j] == -1) { // If slot is free
                slot[j] = i;
                totalProfit += jobs[i].profit;
                break;
            }
        }
    }

    // Step 4: Print the job sequence
    printf("Job Sequence: ");
    for (int i = 1; i <= maxDeadline; i++) {
        if (slot[i] != -1)
            printf("Job %d ", jobs[slot[i]].index);
    }
    printf("\nTotal Profit: %d\n", totalProfit);
}

// Main function
int main() {
    int n;
    printf("Enter the number of jobs: ");
    scanf("%d", &n);

    Job jobs[n];

    printf("Enter Deadline and Profit for each job:\n");
    for (int i = 0; i < n; i++) {
        printf("Job %d: ", i + 1);
        jobs[i].index = i + 1; // Store job number
        scanf("%d %d", &jobs[i].deadline, &jobs[i].profit);
    }

    jobSequencing(jobs, n);

    return 0;
}
