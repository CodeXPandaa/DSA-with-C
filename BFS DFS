
#include <stdio.h>
#define MAX 20

// Queue implementation for BFS
struct Queue {
    int items[MAX];
    int front;
    int rear;
};

void initQueue(struct Queue* q) {
    q->front = -1;
    q->rear = -1;
}

int isEmpty(struct Queue* q) {
    return q->front == -1;
}

void enqueue(struct Queue* q, int value) {
    if(q->rear == MAX-1)
        return;
    if(q->front == -1)
        q->front = 0;
    q->rear++;
    q->items[q->rear] = value;
}

int dequeue(struct Queue* q) {
    if(isEmpty(q))
        return -1;
    int item = q->items[q->front];
    q->front++;
    if(q->front > q->rear) {
        q->front = q->rear = -1;
    }
    return item;
}

void DFS(int graph[MAX][MAX], int n, int vertex, int visited[]) {
    printf("%d ", vertex + 1);
    visited[vertex] = 1;
    
    for(int i = 0; i < n; i++) {
        if(graph[vertex][i] == 1 && !visited[i]) {
            DFS(graph, n, i, visited);
        }
    }
}

void DFSStart(int graph[MAX][MAX], int n, int startVertex) {
    int visited[MAX] = {0};
    printf("\nDFS starting from vertex %d: ", startVertex + 1);
    DFS(graph, n, startVertex, visited);
    printf("\n");
}

void BFS(int graph[MAX][MAX], int n, int startVertex) {
    struct Queue q;
    initQueue(&q);
    
    int visited[MAX] = {0};
    
    printf("\nBFS starting from vertex %d: ", startVertex + 1);
    
    visited[startVertex] = 1;
    printf("%d ", startVertex + 1);
    enqueue(&q, startVertex);
    
    while(!isEmpty(&q)) {
        int currentVertex = dequeue(&q);
        for(int i = 0; i < n; i++) {
            if(graph[currentVertex][i] == 1 && !visited[i]) {
                visited[i] = 1;
                printf("%d ", i + 1);
                enqueue(&q, i);
            }
        }
    }
    printf("\n");
}

void createGraph(int graph[MAX][MAX], int n) {
    int i, j;
    printf("Enter the adjacency matrix:\n");
    printf("Enter 1 if vertices are connected, 0 otherwise\n");
    
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            printf("Edge from vertex %d to %d: ", i+1, j+1);
            scanf("%d", &graph[i][j]);
        }
    }
}

void displayGraph(int graph[MAX][MAX], int n) {
    int i, j;
    printf("\nAdjacency Matrix:\n");
    
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            printf("%d ", graph[i][j]);
        }
        printf("\n");
    }
}

int main(void) {
    int graph[MAX][MAX];
    int numVertices;
    
    printf("Enter number of vertices (max %d): ", MAX);
    scanf("%d", &numVertices);
    
    if(numVertices > 0 && numVertices <= MAX) {
        createGraph(graph, numVertices);
        displayGraph(graph, numVertices);
        
        int startVertex;
        printf("\nEnter starting vertex (1 to %d): ", numVertices);
        scanf("%d", &startVertex);
        
        if(startVertex >= 1 && startVertex <= numVertices) {
            BFS(graph, numVertices, startVertex - 1);
            DFSStart(graph, numVertices, startVertex - 1);
        } else {
            printf("Invalid starting vertex!\n");
        }
    } else {
        printf("Invalid number of vertices!\n");
    }
    
    return 0;
}
