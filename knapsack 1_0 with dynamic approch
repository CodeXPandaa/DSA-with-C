#include <stdio.h>

int max(int a, int b) {
    if (a > b)
        return a;
    else
        return b;
}

int main() {
    int n, m, p[20], wt[20], k[10][10], i, j, w;
    
    printf("Enter the no. of items: ");
    scanf("%d", &n);
    
    printf("Enter the capacity of knapsack: ");
    scanf("%d", &m);
    
    for (i = 1; i <= n; i++) {
        printf("Profit %d: ", i);
        scanf("%d", &p[i]);
        
        printf("weight %d: ", i);
        scanf("%d", &wt[i]);
    }
    
    for (i = 0; i <= n; i++) {
        for (w = 0; w <= m; w++) {
            if (i == 0 || w == 0) {
                k[i][w] = 0;
            } else if (wt[i] <= w) {
                k[i][w] = max(p[i] + k[i - 1][w - wt[i]], k[i - 1][w]);
            } else {
                k[i][w] = k[i - 1][w];
            }
        }
    }

    for (i = 0; i <= n; i++) {
        for (j = 0; j <= m; j++) {
            printf("%d\t", k[i][j]);
        }
        printf("\n");
    }

    i = n;
    w = m;
    printf("Maximum profit is %d\n", k[n][m]);

    while (i > 0 && w > 0) {
        if (k[i][w] == k[i - 1][w]) {
            printf("\nItem %d: 0", i);
            i = i - 1;
        } else {
            printf("\nItem %d: 1", i);
            w = w - wt[i];
            i = i - 1;
        }
    }

    return 0;
}
